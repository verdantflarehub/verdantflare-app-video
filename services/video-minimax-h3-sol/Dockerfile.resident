# syntax=docker/dockerfile:1.7
FROM registry.cn-qingdao.aliyuncs.com/wod/verdantflare-app:vedio-minimax-h3-sol-v0.1.1@sha256:09bd61ea754d279bd55b92448d5a1f6bd1e5cc6ab3cad426b025509faf0bab79
LABEL org.opencontainers.image.version="0.2.6"
COPY resident_api.py resident_worker.py sglang_backend.py /opt/verdantflare-sol/
COPY patches/ /opt/verdantflare-sol/patches/
RUN python /opt/verdantflare-sol/prepare-patched-source.py --source /opt/sol-h3 --output /opt/sol-h3-fixed \
    && rm -rf /opt/sol-h3-experimental \
    && mv /opt/sol-h3-fixed /opt/sol-h3-experimental
COPY tests/test_resident.py /opt/verdantflare-sol/tests/
RUN python -m unittest discover -s /opt/verdantflare-sol/tests -v \
    && python -m compileall -q /opt/verdantflare-sol/resident_api.py /opt/verdantflare-sol/resident_worker.py
ENV PYTHONPATH=/opt/sol-h3-experimental:/opt/verdantflare-sol \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True OMP_NUM_THREADS=12
EXPOSE 8000
ENTRYPOINT ["torchrun", "--standalone", "--nnodes=1", "--nproc_per_node=2", "--max_restarts=0", "/opt/verdantflare-sol/resident_worker.py"]
CMD []

